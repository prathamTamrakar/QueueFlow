# Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=queueflow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/queueflow?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue & Worker Configuration
QUEUE_NAME=default-jobs
DLQ_QUEUE_NAME=dead-letter-jobs
WORKER_CONCURRENCY=5
QUEUE_RATE_MAX=100
QUEUE_RATE_DURATION_MS=1000
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_BACKOFF_DELAY_MS=1000
DEFAULT_JOB_TIMEOUT_MS=30000

# Security & Idempotency
ADMIN_API_KEY=queueflow-admin-secret-key-123
IDEMPOTENCY_TTL_HOURS=24

# Frontend Configuration
VITE_API_URL=http://localhost:4000
VITE_ADMIN_API_KEY=queueflow-admin-secret-key-123
