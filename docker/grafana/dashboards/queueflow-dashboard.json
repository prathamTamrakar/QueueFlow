      "collapsed": false,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Job Throughput (Ops/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(queueflow_jobs_enqueued_total[1m]))",
          "legendFormat": "Enqueued rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(queueflow_jobs_completed_total[1m]))",
          "legendFormat": "Completed rate",
          "refId": "B"
        },
        {
          "expr": "sum(rate(queueflow_jobs_failed_total[1m]))",
          "legendFormat": "Failed rate",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Processing Duration Percentiles",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(queueflow_job_processing_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "p50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(queueflow_job_processing_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(queueflow_job_processing_duration_seconds_bucket[2m])) by (le))",
